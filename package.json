{
  "name": "@epoxide/web",
  "version": "1.0.0",
  "description": "epoxide.se web monorepo",
  "type": "module",
  "engines": {
    "node": "24.x.x"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm --filter @epoxide/web-next build",
    "check": "pnpm -r --if-present check",
    "dev:astro": "pnpm --filter @epoxide/web-astro dev",
    "dev:next": "pnpm --filter @epoxide/web-next dev",
    "dev:nuxt": "pnpm --filter @epoxide/web-nuxt dev",
    "dev:solid-start": "pnpm --filter @epoxide/web-solid-start dev",
    "dev:sveltekit": "pnpm --filter @epoxide/web-sveltekit dev",
    "lint": "pnpm -r --if-present lint",
    "prepare": "husky",
    "start": "pnpm --filter @epoxide/web-next start",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "update-snapshots": "pnpm --filter @epoxide/web-next update-snapshots"
  },
  "author": {
    "name": "Tomas Tannergren",
    "email": "epoxide@epoxide.se",
    "url": "https://epoxide.se"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/epoxide/epoxide-web.git"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "1.54.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-promise": "^7.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^7.0.6"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.0"
  }
}
