{
  "name": "@epoxide/web-next",
  "version": "1.0.0",
  "description": "epoxide.se web using Next 16",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --rule 'no-console: error' --rule 'prettier/prettier: error'",
    "test": "playwright test",
    "test:no-snapshots": "playwright test --grep-invert @snapshot",
    "update-snapshots": "node scripts/update-snapshots.mjs",
    "check": "next typegen && tsc --noEmit"
  },
  "author": {
    "name": "Tomas Tannergren",
    "email": "epoxide@epoxide.se",
    "url": "https://epoxide.se"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/epoxide/epoxide-web.git"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "eslint-config-next": "catalog:next",
    "schema-dts": "catalog:"
  },
  "dependencies": {
    "@epoxide/web-assets": "workspace:*",
    "@epoxide/web-constants": "workspace:*",
    "next": "catalog:next",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  }
}
