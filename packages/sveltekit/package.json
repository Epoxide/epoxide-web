{
  "name": "@epoxide/web-sveltekit",
  "version": "1.0.0",
  "description": "epoxide.se web using SvelteKit 3",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "author": {
    "name": "Tomas Tannergren",
    "email": "epoxide@epoxide.se",
    "url": "https://epoxide.se"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/epoxide/epoxide-web.git"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . --rule 'no-console: error' --rule 'prettier/prettier: error'",
    "test": "playwright test"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint-plugin-svelte": "catalog:eslint",
    "prettier-plugin-svelte": "^4.1.1",
    "schema-dts": "catalog:",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@epoxide/web-assets": "workspace:*",
    "@epoxide/web-constants": "workspace:*"
  }
}
